{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": [
      "**",
      "!dist",
      "!public",
      "!node_modules",
      "!schema",
      "!package-lock.json",
      "!test-results",
      "!playwright-report"
    ]
  },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 110 },
  "javascript": { "formatter": { "quoteStyle": "double", "trailingCommas": "all" } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": { "noNonNullAssertion": "off", "noDescendingSpecificity": "off" },
      "suspicious": { "noAssignInExpressions": "off" }
    }
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
