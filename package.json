{
  "name": "vautour",
  "version": "0.1.0",
  "description": "Paragliding cross-country navigation app, GPS-style, driven by cheminee flight packages.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:phone": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "npm run typecheck && npm run lint && npm run test",
    "e2e": "playwright test",
    "e2e:android": "playwright test --project=android",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.9",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.7",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
